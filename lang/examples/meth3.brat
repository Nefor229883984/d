assert("hello".index_of("ll") == 2)
assert(is_none("hello".index_of("zz")))
assert("ab".repeat(3) == "ababab")
assert("ab".repeat(0) == "")
assert("x".repeat(2) == "xx")
let so = "a=b=c".split_once("=")
assert(so[0] == "a")
assert(so[1] == "b=c")
assert(is_none("abc".split_once("z")))
let e1 = "".split_once("x")
assert(is_none(e1))
let mut v = [1, 2, 3]
assert(v.ins(1, 9) == 4)
assert(v == [1, 9, 2, 3])
v.ins(-1, 7)
assert(v == [1, 9, 2, 7, 3])
assert(v.del(0) == 1)
assert(v == [9, 2, 7, 3])
assert(v.del(-1) == 3)
assert(v == [9, 2, 7])
assert(v.slice(1, 3) == [2, 7])
assert(v.slice(0, 99) == [9, 2, 7])
assert(v.slice(-2, 3) == [2, 7])
assert([5, 10, 15].sum() == 30)
assert([].sum() == 0)
assert([1.5, 2.5].sum() == 4.0)
assert([3, 1, 2].min() == 1)
assert([3, 1, 2].max() == 3)
assert(is_none([].min()))
assert(is_none([].max()))
assert(["b", "a"].min() == "a")
let en = [10, 20].enumerate()
assert(en[0][0] == 0)
assert(en[0][1] == 10)
assert(en[1][0] == 1)
let m = {"a": 1, "b": 2}
let it = m.items()
assert(it[0][0] == "a")
assert(it[0][1] == 1)
assert(it[1][0] == "b")
assert(it[1][1] == 2)
assert(m.vals() == [1, 2])
assert(m.keys() == ["a", "b"])
print("meth3 ok")
