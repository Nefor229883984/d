let v = [3, 7, 11]
assert(7 in v)
assert(!(9 in v))
assert(!(7 in []))
let m = {"a": 1, "b": 2}
assert("a" in m)
assert(!("zz" in m))
assert("ell" in "hello")
assert(!("z" in "hello"))
let mut found = 0
for x in v {
  if x in [7, 11] {
    found = found + 1
  }
}
assert(found == 2)
assert(!("x" in [1, 2]))
print("in ok")
