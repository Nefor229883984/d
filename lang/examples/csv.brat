pub fn csv_field_quote(f: str) -> str {
  if f.contains(",") || f.contains("\"") || f.contains("\n") || f.contains("\r") {
    return "\"" + f.replace("\"", "\"\"") + "\""
  }
  return f
}
pub fn csv_dump(rows: vec[vec[str]]) -> str {
  let mut out = ""
  for row in rows {
    let mut sep = ""
    for f in row {
      out += sep
      out += csv_field_quote(f)
      sep = ","
    }
    out += "\n"
  }
  return out
}
pub fn csv_parse(text: str) {
  let mut rows = []
  let mut row = []
  let mut field = ""
  let mut quoted = false
  let mut started = false
  let mut i = 0
  let n = len(text)
  while i < n {
    let ch = text[i]
    if quoted {
      if ch == "\"" {
        if i + 1 < n && text[i + 1] == "\"" {
          field += "\""
          i += 2
        } else {
          quoted = false
          i += 1
        }
      } else {
        field += ch
        i += 1
      }
    } else {
      if ch == "\"" && !started {
        quoted = true
        started = true
        i += 1
      } else {
        if ch == "," {
          row.push(field)
          field = ""
          started = false
          i += 1
        } else {
          if ch == "\n" || ch == "\r" {
            let mut step = 1
            if ch == "\r" && i + 1 < n && text[i + 1] == "\n" {
              step = 2
            }
            if len(row) == 0 && field == "" {
              rows.push([])
            } else {
              row.push(field)
              rows.push(row)
              row = []
            }
            field = ""
            started = false
            i += step
          } else {
            field += ch
            started = true
            i += 1
          }
        }
      }
    }
  }
  if quoted {
    return Err("unterminated quoted field")
  }
  if len(row) > 0 || field != "" {
    row.push(field)
    rows.push(row)
  }
  return Ok(rows)
}
pub fn csv_row_parse(line: str) {
  let r = csv_parse(line)
  if is_err(r) {
    return r
  }
  let rows = unwrap(r)
  if len(rows) != 1 {
    return Err("want 1 row, got " + str(len(rows)))
  }
  return Ok(rows[0])
}
fn expect(cond: bool, name: str) -> i64 {
  if cond {
    print("ok " + name)
  } else {
    print("FAIL " + name)
    return 1
  }
  return 0
}
fn main() -> i64 {
  let mut bad = 0
  bad += expect(csv_dump([]) == "", "dump empty")
  bad += expect(csv_dump([["a", "b"], ["c"]]) == "a,b\nc\n", "dump rows")
  bad += expect(csv_dump([["a,b", "c"]]) == "\"a,b\",c\n", "dump quoted comma")
  bad += expect(csv_dump([["say \"hi\""]]) == "\"say \"\"hi\"\"\"\n", "dump escaped quote")
  bad += expect(csv_dump([["x\ny"]]) == "\"x\ny\"\n", "dump quoted newline")
  bad += expect(csv_dump([["", ""]]) == ",\n", "dump empty fields")
  let p1 = csv_parse("a,b\nc,d")?
  bad += expect(len(p1) == 2, "parse two rows")
  bad += expect(p1[0][0] == "a" && p1[0][1] == "b", "parse first row")
  bad += expect(p1[1][0] == "c" && p1[1][1] == "d", "parse last row")
  bad += expect(csv_parse("")? == [], "parse empty text")
  bad += expect(csv_parse("\n")? == [[]], "parse blank line")
  bad += expect(csv_parse("a\n")? == [["a"]], "parse trailing newline")
  bad += expect(csv_parse("a,b\n\nc")? == [["a", "b"], [], ["c"]], "parse interior blank")
  bad += expect(csv_parse("a,b")? == [["a", "b"]], "parse no newline")
  bad += expect(csv_parse("a,b\r\nc,d\r\n")? == [["a", "b"], ["c", "d"]], "parse crlf")
  bad += expect(csv_parse("a\rb")? == [["a"], ["b"]], "parse lone cr")
  bad += expect(csv_parse("\"a,b\",c")? == [["a,b", "c"]], "parse quoted comma")
  bad += expect(csv_parse("\"a\"\"b\"")? == [["a\"b"]], "parse doubled quote")
  bad += expect(csv_parse("\"a\nb\"")? == [["a\nb"]], "parse quoted newline")
  bad += expect(csv_parse(" a , b ")? == [[" a ", " b "]], "parse keeps spaces")
  bad += expect(csv_parse("a\"b")? == [["a\"b"]], "parse inner quote literal")
  bad += expect(is_err(csv_parse("\"abc")), "parse unterminated quote")
  bad += expect(is_err(csv_parse("a,\"b\nc")), "parse unterminated multiline")
  let r1 = csv_row_parse("a,b,c")?
  bad += expect(len(r1) == 3 && r1[2] == "c", "row parse three")
  let rq = csv_row_parse("\"a,b\",c")?
  bad += expect(len(rq) == 2 && rq[0] == "a,b", "row parse quoted comma")
  bad += expect(is_err(csv_row_parse("a\nb")), "row parse rejects two rows")
  bad += expect(is_err(csv_row_parse("")), "row parse rejects empty")
  let rt = csv_dump(csv_parse("a,\"b,c\"\n\"x\"\"y\",z")?)
  bad += expect(rt == "a,\"b,c\"\n\"x\"\"y\",z\n", "round trip")
  bad += expect(csv_parse(csv_dump([["a", "b"], []]))? == [["a", "b"], []], "dump parse idempotent")
  if bad > 0 {
    print("csv {bad} FAIL")
    return 1
  }
  print("csv ok")
  return 0
}
