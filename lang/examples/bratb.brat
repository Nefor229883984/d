fn is_digit(ch: str) -> i64 {
  return ch >= "0" && ch <= "9"
}
fn is_alpha(ch: str) -> i64 {
  return (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}
fn is_alnum(ch: str) -> i64 {
  return is_alpha(ch) || is_digit(ch)
}
fn is_kw(w: str) -> i64 {
  return w in ["let", "mut", "fn", "if", "else", "while", "return", "true", "false", "or", "try", "catch", "spawn", "match", "for", "in", "import", "defer", "move", "break", "continue", "impl", "self", "trait", "enum", "const", "pub"]
}
fn s_slice(s: str, a: i64, b: i64) -> str {
  let mut out = ""
  let mut k = a
  while k < b && k < len(s) {
    out += s[k]
    k += 1
  }
  return out
}
fn expand_str(raw: str) {
  if !raw.contains("{") {
    return ["str", raw]
  }
  let mut parts = []
  let mut buf = ""
  let mut i: i64 = 0
  while i < len(raw) {
    let ch = raw[i]
    if ch == "{" {
      let mut j = i + 1
      let mut depth = 1
      while j < len(raw) && depth > 0 {
        if raw[j] == "{" {
          depth += 1
        } else {
          if raw[j] == "}" {
            depth -= 1
          }
        }
        j += 1
      }
      if depth == 0 {
        let sub = parse_sub(s_slice(raw, i + 1, j - 1))
        if !is_none(sub) {
          if len(buf) > 0 {
            parts.push(["lit", buf])
            buf = ""
          }
          parts.push(["expr", sub])
          i = j
        } else {
          buf = buf + ch
          i += 1
        }
      } else {
        buf = buf + ch
        i += 1
      }
    } else {
      buf = buf + ch
      i += 1
    }
  }
  if len(buf) > 0 {
    parts.push(["lit", buf])
  }
  if len(parts) == 0 {
    return ["str", ""]
  }
  if len(parts) == 1 {
    if parts[0][0] == "expr" {
      return parts[0][1]
    }
    return ["rstr", parts[0][1]]
  }
  let mut node = parts[0][1]
  if parts[0][0] == "lit" {
    node = ["rstr", parts[0][1]]
  }
  let mut k: i64 = 1
  while k < len(parts) {
    let p = parts[k]
    let mut nxt = p[1]
    if p[0] == "lit" {
      nxt = ["rstr", p[1]]
    }
    node = ["bin", "+", node, nxt]
    k += 1
  }
  return node
}
fn parse_sub(text: str) {
  let toks = lex(text)
  if len(toks) == 0 {
    return None
  }
  let saved_tks = tks
  let saved_ci = ci
  let saved_seq = seq
  tks = toks
  ci = 0
  let node = None
  let ok = true
  try {
    let e = parse_expr()?
    if peek()[0] == "EOF" {
      node = e
    }
  } catch e {
    ok = false
  }
  tks = saved_tks
  ci = saved_ci
  seq = saved_seq
  if !ok {
    return None
  }
  return node
}
fn lex(src: str) -> vec {
  let mut toks = []
  let mut i: i64 = 0
  let mut line: i64 = 1
  while i < len(src) {
    let ch = src[i]
    if ch == "\n" {
      line += 1
      i += 1
    } else {
      if ch == " " || ch == "\t" || ch == "\r" {
        i += 1
      } else {
        if ch == "/" && i + 1 < len(src) && src[i + 1] == "/" {
          while i < len(src) && src[i] != "\n" {
            i += 1
          }
        } else {
          if ch == "\"" {
            let mut j = i + 1
            let mut depth = 0
            let mut paren = 0
            let mut ended = false
            while j < len(src) {
              let sc = src[j]
              if sc == "\n" {
                line += 1
              }
              if sc == "\\" {
                j += 2
                continue
              }
              if sc == "{" {
                depth += 1
              } else {
                if sc == "}" {
                  if depth > 0 {
                    depth -= 1
                  }
                } else {
                  if sc == "(" {
                    paren += 1
                  } else {
                    if sc == ")" {
                      if paren > 0 {
                        paren -= 1
                      }
                    } else {
                      if sc == "\"" {
                        if depth == 0 || paren == 0 {
                          ended = true
                          break
                        }
                      }
                    }
                  }
                }
              }
              j += 1
            }
            if !ended {
              j = len(src) - 1
            }
            toks.push(["STR", s_slice(src, i, j + 1), line])
            i = j + 1
          } else {
            if is_digit(ch) {
              let mut j = i
              let mut seen_dot = false
              while j < len(src) && (is_digit(src[j]) || (src[j] == "." && !seen_dot && is_digit(src[j + 1]))) {
                if src[j] == "." {
                  seen_dot = true
                }
                j += 1
              }
              toks.push(["NUM", s_slice(src, i, j), line])
              i = j
            } else {
              if is_alpha(ch) {
                let mut j = i
                while j < len(src) && is_alnum(src[j]) {
                  j += 1
                }
                let w = s_slice(src, i, j)
                if is_kw(w) {
                  toks.push(["KW", w, line])
                } else {
                  toks.push(["ID", w, line])
                }
                i = j
              } else {
                let two = s_slice(src, i, i + 2)
                if two in ["..", "=>", "->", "==", "!=", "<=", ">=", "&&", "||", "+=", "-=", "*=", "/=", "%="] {
                  toks.push(["OP", two, line])
                  i += 2
                } else {
                  if ch == "." {
                    toks.push(["DOT", ".", line])
                  } else {
                    if ch in ["+", "-", "*", "/", "%", "<", ">", "=", "!", "{", "}", "(", ")", "[", "]", ",", ":", ";", "?"] {
                      toks.push(["OP", ch, line])
                    }
                  }
                  i += 1
                }
              }
            }
          }
        }
      }
    }
  }
  return toks
}
let mut tks = []
let mut ci: i64 = 0
let mut seq: i64 = 0
fn fresh(tag: str) -> str {
  seq += 1
  return "@" + tag + str(seq)
}
fn peek() -> vec {
  if ci < len(tks) {
    return tks[ci]
  }
  return ["EOF", "", 0]
}
fn step() -> vec {
  let t = peek()
  if t[0] == "EOF" {
    raise("unexpected end of file")
  }
  ci += 1
  return t
}
fn want(v: str) -> vec {
  let t = step()?
  if t[1] != v {
    raise("want " + v + " have " + t[1])
  }
  return t
}
fn eline() -> i64 {
  let t = peek()
  if t[0] == "EOF" {
    if ci > 0 {
      return tks[ci - 1][2]
    }
    return 1
  }
  return t[2]
}
fn unesc(s: str) -> str {
  let mut out = ""
  let mut i: i64 = 0
  while i < len(s) {
    if s[i] == "\\" && i + 1 < len(s) {
      let n = s[i + 1]
      if n == "n" {
        out += "\n"
      } else {
        if n == "t" {
          out += "\t"
        } else {
          if n == "r" {
            out += "\r"
          } else {
            if n == "0" {
              out += "\0"
            } else {
              if n in ["\\", "\"", "'"] {
                out += n
              } else {
                out += "\\" + n
              }
            }
          }
        }
      }
      i += 2
    } else {
      out += s[i]
      i += 1
    }
  }
  return out
}
fn ann_or_nul(a: vec) -> vec {
  if a[0] {
    return a[1]
  }
  return ["nul"]
}
fn ann_text(toks: vec) -> vec {
  if len(toks) > 0 && toks[0] in ["move", "mut", "ref"] {
    return [true, s_slice(toks[0] + "x", 0, 0) + join_all_text(toks, 1)]
  }
  if len(toks) == 0 {
    return [false, ""]
  }
  return [true, join_all_text(toks, 0)]
}
fn join_all_text(toks: vec, from: i64) -> str {
  let mut out = ""
  let mut k = from
  while k < len(toks) {
    out += toks[k]
    k += 1
  }
  return out
}
fn parse_params() -> vec {
  let mut params = []
  while peek()[1] != ")" {
    let mut pn = step()[1]
    let mut mode = "ref"
    if pn in ["move", "mut", "ref"] && peek()[1] != ":" {
      mode = pn
      pn = step()[1]
    }
    let mut ann = [false, ""]
    if peek()[1] == ":" {
      step()?
      let mut depth = 0
      let mut first = ""
      let mut toks = []
      while true {
        let x = peek()
        if x[1] in [",", ")", "="] && depth == 0 {
          break
        }
        if x[1] == "[" {
          depth += 1
        }
        if x[1] == "]" {
          depth -= 1
        }
        if first == "" && depth == 0 && x[0] in ["ID", "KW"] {
          first = x[1]
        }
        toks.push(x[1])
        step()?
      }
      if first in ["move", "mut", "ref"] {
        mode = first
      }
      ann = ann_text(toks)
    }
    let mut default = ["nul"]
    if peek()[1] == "=" {
      step()?
      default = parse_expr()?
    }
    params.push(["@pair", pn, mode, ann_or_nul(ann), default])
    if peek()[1] == "," {
      step()?
    }
  }
  let mut seen = false
  for p in params {
    if p[3][0] != "nul" {
      seen = true
    } else {
      if seen {
        raise("param without default after default")
      }
    }
  }
  return params
}
fn parse_fn() -> vec {
  want("fn")?
  let name = step()[1]
  let mut tparams = []
  if peek()[1] == "<" {
    step()?
    while peek()[1] != ">" {
      let t = step()?
      if t[0] != "ID" && t[0] != "KW" {
        raise("want type param have " + t[1])
      }
      tparams.push(t[1])
      if peek()[1] == "," {
        step()?
      }
    }
    want(">")?
  }
  if len(tparams) != len(tparams.copy().sort().rev().rev()) {
    raise("dup")
  }
  let mut seen2 = {}
  for tp in tparams {
    if tp in seen2 {
      raise("duplicate type param")
    }
    seen2[tp] = 1
  }
  want("(")?
  let params = parse_params()?
  want(")")?
  let mut ret = [false, ""]
  if peek()[1] == "->" {
    step()?
    if peek()[1] in ["move", "ref"] {
      if step()[1] == "ref" {
        raise("ref returns dangle; return owned")
      }
    }
    let mut toks = []
    while peek()[1] != "{" {
      toks.push(step()[1])
    }
    ret = ann_text(toks)
  }
  want("{")?
  let b = parse_block()?
  want("}")?
  return ["fn", name, params, b, tparams, ann_or_nul(ret)]
}
fn parse_let(isc: i64) -> vec {
  if isc == 0 {
    want("let")?
  }
  let mut mut_ = false
  if peek()[1] == "mut" {
    step()?
    mut_ = true
  }
  if isc != 0 && mut_ {
    raise("const cannot be mut")
  }
  if peek()[1] == "[" {
    if isc != 0 {
      raise("const destructure unsupported")
    }
    step()?
    let mut names = []
    while peek()[1] != "]" {
      names.push(step()[1])
      if peek()[1] == "," {
        step()?
      }
    }
    want("]")?
    want("=")?
    let e = parse_expr()?
    if peek()[1] == ";" {
      step()?
    }
    let tm = fresh("d")
    let out = [["let", tm, e, false]]
    let mut ix = 0
    for name in names {
      if name != "_" {
        out.push(["let", name, ["idx", ["var", tm], ["num", ix]], mut_])
      }
      ix += 1
    }
    return ["@lst", out]
  }
  let name = step()[1]
  let mut ann = [false, ""]
  if peek()[1] == ":" {
    step()?
    let mut toks = []
    let mut depth = 0
    while true {
      let x = peek()
      if x[1] == "=" && depth == 0 {
        break
      }
      if x[1] == "[" {
        depth += 1
      }
      if x[1] == "]" {
        depth -= 1
      }
      toks.push(x[1])
      step()?
    }
    ann = ann_text(toks)
  }
  want("=")?
  let e = parse_expr()?
  if peek()[1] == ";" {
    step()?
  }
  if isc == 0 {
    return ["let", name, e, mut_, false, ann_or_nul(ann)]
  }
  return ["let", name, e, false, true, ann_or_nul(ann)]
}
fn parse_block() -> vec {
  let mut stmts = []
  while peek()[1] != "}" {
    let r = parse_stmt()?
    if r[0] == "@lst" {
      for x in r[1] {
        stmts.push(x)
      }
    } else {
      stmts.push(r)
    }
  }
  return stmts
}
fn parse_stmt() -> vec {
  let ln = eline()
  let r = _parse_stmt()?
  if r[0] == "@lst" {
    for s in r[1] {
      s.push({"ln": ln})
    }
  } else {
    r.push({"ln": ln})
  }
  return r
}
fn _parse_stmt() -> vec {
  let t = peek()
  if t[0] == "KW" && t[1] == "let" {
    return parse_let(0)?
  }
  if t[0] == "KW" && t[1] == "const" {
    step()?
    return parse_let(1)?
  }
  if t[0] == "KW" && t[1] == "fn" {
    return parse_fn()?
  }
  if t[0] == "KW" && t[1] == "if" {
    return parse_if()?
  }
  if t[0] == "KW" && t[1] == "while" {
    return parse_while()?
  }
  if t[0] == "KW" && t[1] == "for" {
    return parse_for()?
  }
  if t[0] == "KW" && t[1] == "impl" {
    return parse_impl()?
  }
  if t[0] == "KW" && t[1] == "trait" {
    return parse_trait()?
  }
  if t[0] == "KW" && t[1] == "enum" {
    return parse_enum()?
  }
  if t[0] == "KW" && t[1] == "pub" {
    step()?
    let u = peek()
    if u[0] == "KW" && u[1] == "fn" {
      return ["pub", parse_fn()?]
    }
    if u[0] == "KW" && u[1] == "enum" {
      return ["pub", parse_enum()?]
    }
    if u[0] == "KW" && u[1] == "trait" {
      return ["pub", parse_trait()?]
    }
    if u[0] == "KW" && u[1] == "impl" {
      return ["pub", parse_impl()?]
    }
    raise("pub wants fn/enum/trait/impl")
  }
  if t[0] == "KW" && t[1] in ["break", "continue"] {
    step()?
    if peek()[1] == ";" {
      step()?
    }
    return [t[1]]
  }
  if t[0] == "KW" && t[1] == "match" {
    return parse_match()?
  }
  if t[0] == "KW" && t[1] == "return" {
    step()?
    let mut e = ["none"]
    if peek()[1] == "}" || peek()[1] == ";" {
      if peek()[1] == ";" {
        step()?
      }
      return ["return", e]
    }
    e = parse_expr()?
    if peek()[1] == ";" {
      step()?
    }
    return ["return", e]
  }
  if t[0] == "KW" && t[1] == "try" {
    return parse_try()?
  }
  if t[0] == "KW" && t[1] == "spawn" {
    step()?
    want("{")?
    let b = parse_block()?
    want("}")?
    return ["spawn", b]
  }
  if t[0] == "KW" && t[1] == "defer" {
    step()?
    let e = parse_expr()?
    if peek()[1] == ";" {
      step()?
    }
    return ["defer", e]
  }
  if t[0] == "KW" && t[1] == "import" {
    step()?
    let mut parts = [step()[1]]
    while peek()[1] == "." {
      step()?
      parts.push(step()[1])
    }
    if peek()[1] == ";" {
      step()?
    }
    return ["import", parts.join(".")]
  }
  if t[0] == "ID" && tks[ci + 1][1] == "=" {
    let name = step()[1]
    step()?
    let e = parse_expr()?
    if peek()[1] == ";" {
      step()?
    }
    return ["set", name, e]
  }
  if t[0] == "ID" && tks[ci + 1][1] in ["+=", "-=", "*=", "/=", "%="] {
    let name = step()[1]
    let op = s_slice(step()[1], 0, 1)
    let e = parse_expr()?
    if peek()[1] == ";" {
      step()?
    }
    return ["set", name, ["bin", op, ["var", name], e]]
  }
  let e = parse_expr()?
  if peek()[1] == "=" || peek()[1] in ["+=", "-=", "*=", "/=", "%="] {
    let op = step()[1]
    let val = parse_expr()?
    if peek()[1] == ";" {
      step()?
    }
    if e[0] == "idx" {
      if op != "=" {
        val = ["bin", s_slice(op, 0, 1), ["idx", e[1], e[2]], val]
      }
      return ["setidx", e[1], e[2], val]
    }
    if e[0] == "field" {
      if op != "=" {
        val = ["bin", s_slice(op, 0, 1), e, val]
      }
      return ["setfield", e[1], e[2], val]
    }
    raise("bad assign target")
  }
  if peek()[1] == ";" {
    step()?
  }
  return ["expr", e]
}
fn parse_if() -> vec {
  want("if")?
  if peek()[0] == "KW" && peek()[1] == "let" {
    step()?
    let pat = parse_pattern()?
    want("=")?
    let scrut = parse_expr()?
    want("{")?
    let then = parse_block()?
    want("}")?
    let mut els = ["nul"]
    if peek()[1] == "else" {
      step()?
      if peek()[1] == "if" {
        els = ["@lst2", parse_if()?]
      } else {
        want("{")?
        els = parse_block()?
        want("}")?
      }
    }
    let tm = fresh("m")
    let node = build_if(["var", tm], pat, then, els, ["nul"])
    return ["@lst", [["let", tm, scrut, false], node]]
  }
  let cond = parse_expr()?
  want("{")?
  let then = parse_block()?
  want("}")?
  let mut els = ["nul"]
  if peek()[1] == "else" {
    step()?
    if peek()[1] == "if" {
      els = ["@lst2", parse_if()?]
    } else {
      want("{")?
      els = parse_block()?
      want("}")?
    }
  }
  return ["if", cond, then, els]
}
fn parse_while() -> vec {
  want("while")?
  if peek()[0] == "KW" && peek()[1] == "let" {
    step()?
    let pat = parse_pattern()?
    want("=")?
    let scrut = parse_expr()?
    want("{")?
    let body = parse_block()?
    want("}")?
    let tm = fresh("m")
    let inner = build_if(["var", tm], pat, body, [["break"]], ["nul"])
    return ["@lst", [["while", ["bool", true], [["let", tm, scrut, false], inner]]]]
  }
  let cond = parse_expr()?
  want("{")?
  let b = parse_block()?
  want("}")?
  return ["while", cond, b]
}
fn parse_try() -> vec {
  want("try")?
  want("{")?
  let b = parse_block()?
  want("}")?
  want("catch")?
  let mut ename = ["nul"]
  if peek()[1] != "{" {
    ename = step()[1]
  }
  want("{")?
  let h = parse_block()?
  want("}")?
  return ["try", b, h, ename]
}
fn parse_for() -> vec {
  want("for")?
  let v = step()?
  if v[0] != "ID" {
    raise("want loop var have " + v[1])
  }
  want("in")?
  let start = parse_expr()?
  if peek()[1] == ".." {
    step()?
    let end = parse_expr()?
    want("{")?
    let body = parse_block()?
    want("}")?
    return ["forrange", v[1], start, end, body]
  }
  want("{")?
  let body = parse_block()?
  want("}")?
  return ["foriter", v[1], start, body]
}
fn parse_enum() -> vec {
  want("enum")?
  let tname = step()[1]
  want("{")?
  let mut variants = []
  while peek()[1] != "}" {
    let v = step()?
    if v[0] != "ID" && v[0] != "KW" {
      raise("want variant have " + v[1])
    }
    let mut fields = []
    if peek()[1] == "(" {
      step()?
      while peek()[1] != ")" {
        let f = step()?
        if f[0] != "ID" && f[0] != "KW" {
          raise("want field have " + f[1])
        }
        fields.push(f[1])
        if peek()[1] == "," {
          step()?
        }
      }
      want(")")?
    }
    variants.push(["@pair", v[1], fields])
    if peek()[1] == "," {
      step()?
    }
  }
  want("}")?
  return ["enum", tname, variants]
}
fn parse_sig() -> vec {
  want("fn")?
  let name = step()[1]
  want("(")?
  let full = parse_params()?
  let mut params = []
  for p in full {
    params.push(["@pair", p[1], p[2], p[3]])
  }
  want(")")?
  let mut ret = [false, ""]
  if peek()[1] == "->" {
    step()?
    if peek()[1] in ["move", "ref"] {
      if step()[1] == "ref" {
        raise("ref returns dangle; return owned")
      }
    }
    let mut toks = []
    while peek()[1] != "}" && !(peek()[0] == "KW" && peek()[1] == "fn") {
      toks.push(step()[1])
    }
    ret = ann_text(toks)
  }
  return ["sig", name, params, ret[1]]
}
fn parse_trait() -> vec {
  want("trait")?
  let name = step()[1]
  want("{")?
  let mut sigs = []
  while peek()[1] != "}" {
    sigs.push(parse_sig()?)
  }
  want("}")?
  return ["trait", name, sigs]
}
fn parse_impl() -> vec {
  want("impl")?
  let first = step()[1]
  let mut tr = ["nul"]
  let mut tname = first
  if peek()[1] == "for" {
    step()?
    tr = first
    tname = step()[1]
  }
  want("{")?
  let mut fns = []
  while peek()[1] != "}" {
    fns.push(parse_fn()?)
  }
  want("}")?
  return ["impl", tr, tname, fns]
}
fn parse_pat_arg() -> vec {
  let t = peek()
  if t[0] == "ID" && t[1] == "_" {
    step()?
    return ["wild"]
  }
  if t[0] == "ID" && t[1] == "None" {
    step()?
    return ["none"]
  }
  if t[0] == "KW" && t[1] in ["true", "false"] {
    step()?
    return ["lit", ["bool", t[1] == "true"]]
  }
  if t[0] == "ID" && tks[ci + 1][1] == "(" {
    step()?
    let vname = t[1]
    want("(")?
    let mut subs = []
    while peek()[1] != ")" {
      subs.push(parse_pat_arg()?)
      if peek()[1] == "," {
        step()?
      }
    }
    want(")")?
    return ["variant", lower_first(vname), subs]
  }
  if t[0] == "NUM" {
    step()?
    if t[1].contains(".") {
      return ["lit", ["num", unwrap(t[1].parse_float())]]
    }
    return ["lit", ["num", unwrap(t[1].parse_int())]]
  }
  if t[0] == "STR" {
    step()?
    return ["lit", expand_str(unesc(s_slice(t[1], 1, len(t[1]) - 1)))]
  }
  if t[0] == "ID" {
    step()?
    return ["bind", t[1]]
  }
  raise("bad pattern arg " + t[1])
  return ["bad"]
}
fn lower_first(s: str) -> str {
  return s.lower()
}
fn parse_pattern() -> vec {
  let t = peek()
  if t[0] == "ID" && t[1] == "_" {
    step()?
    return ["nul"]
  }
  let p = parse_pat_arg()?
  if p[0] == "bind" {
    if s_slice(p[1], 0, 1) >= "A" && s_slice(p[1], 0, 1) <= "Z" {
      return ["variant", lower_first(p[1]), []]
    }
    return ["bind", p[1]]
  }
  return p
}
fn build_if(tm: vec, pat: vec, body: vec, rest: vec, guard: vec) -> vec {
  if guard[0] != "nul" && pat[0] != "nul" && pat[0] != "wild" {
    body = [["if", guard, body, rest]]
  }
  if pat[0] == "nul" || pat[0] == "wild" {
    return ["@grp", body]
  }
  if pat[0] == "lit" {
    return ["if", ["bin", "==", tm, pat[1]], body, rest]
  }
  if pat[0] == "none" {
    return ["if", ["call", "is_none", [tm]], body, rest]
  }
  if pat[0] == "variant" {
    let tag = pat[1]
    let subs = pat[2]
    let cond = ["bin", "==", ["call", "tagof", [tm]], ["str", tag]]
    let mut pre = []
    let mut inner = body
    let mut j = len(subs)
    while j > 0 {
      j -= 1
      let sp = subs[j]
      let acc = ["call", "__at", [tm, ["num", j + 1]]]
      if sp[0] == "bind" {
        pre.push(["let", sp[1], acc, false])
      } else {
        if sp[0] != "wild" {
          let t = fresh("p")
          pre.push(["let", t, acc, false])
          inner = [build_if(["var", t], sp, inner, rest, ["nul"])]
        }
      }
    }
    return ["if", cond, pre + inner, rest]
  }
  if pat[0] == "bind" {
    return ["@grp", [["let", pat[1], tm, false]] + body]
  }
  raise("bad match pattern")
  return ["bad"]
}
fn parse_match() -> vec {
  let ml = eline()
  want("match")?
  let scrut = parse_expr()?
  want("{")?
  let mut arms = []
  let mut seen = []
  while peek()[1] != "}" {
    let pat = parse_pattern()?
    let mut guard = ["nul"]
    if peek()[0] == "KW" && peek()[1] == "if" {
      step()?
      guard = parse_expr()?
    }
    want("=>")?
    if pat[0] != "nul" {
      let key = sexp(pat) + sexp(guard)
      if key in seen {
        raise("duplicate match pattern " + key)
      }
      seen.push(key)
    }
    let mut body = []
    if peek()[1] == "{" {
      step()?
      body = parse_block()?
      want("}")?
    } else {
      body = [parse_stmt()?]
    }
    arms.push([pat, guard, body])
    if peek()[1] == "," {
      step()?
    }
  }
  want("}")?
  if len(arms) == 0 {
    raise("match needs arms")
  }
  let tm = fresh("m")
  let mut node = ["nul"]
  let mut ai = len(arms)
  while ai > 0 {
    ai -= 1
    let arm = arms[ai]
    let pat = arm[0]
    let guard = arm[1]
    let body = arm[2]
    if pat[0] == "nul" || (pat[0] in ["wild", "bind"] && guard[0] == "nul") {
      if node[0] != "nul" {
        raise("_ must be last")
      }
      if pat[0] == "bind" {
        node = ["@grp", [["let", pat[1], ["var", tm], false]] + body]
      } else {
        node = ["@grp", body]
      }
    } else {
      let mut rest = []
      if node[0] != "nul" {
        rest = node
      }
      node = build_if(["var", tm], pat, body, rest, guard)
    }
  }
  if node[0] == "nul" {
    return ["@lst", [["expr", scrut]]]
  }
  if node[0] == "@grp" {
    return ["@lst", [["let", tm, scrut, false]] + node[1]]
  }
  return ["@lst", [["let", tm, scrut, false], node]]
}
fn parse_expr() -> vec {
  return parse_or()?
}
fn parse_or() -> vec {
  let mut e = parse_and()?
  while peek()[1] == "or" {
    step()?
    e = ["or", e, parse_and()?]
  }
  return e
}
fn parse_and() -> vec {
  let mut e = parse_cmp()?
  while peek()[1] in ["&&", "||"] {
    let op = step()[1]
    e = ["bin", op, e, parse_cmp()?]
  }
  return e
}
fn parse_cmp() -> vec {
  let mut e = parse_add()?
  while peek()[1] in ["==", "!=", "<", ">", "<=", ">=", "in"] {
    let op = step()[1]
    e = ["bin", op, e, parse_add()?]
  }
  return e
}
fn parse_add() -> vec {
  let mut e = parse_mul()?
  while peek()[1] in ["+", "-"] {
    let op = step()[1]
    e = ["bin", op, e, parse_mul()?]
  }
  return e
}
fn parse_mul() -> vec {
  let mut e = parse_un()?
  while peek()[1] in ["*", "/", "%"] {
    let op = step()[1]
    e = ["bin", op, e, parse_un()?]
  }
  return e
}
fn parse_un() -> vec {
  if peek()[1] in ["!", "-"] {
    let op = step()[1]
    return ["un", op, parse_un()?]
  }
  if peek()[0] == "KW" && peek()[1] == "move" {
    step()?
    return ["move", parse_un()?]
  }
  return parse_post()?
}
fn parse_post() -> vec {
  let mut e = parse_prim()?
  while true {
    if peek()[1] == "?" {
      step()?
      e = ["quest", e]
    } else {
      if peek()[1] == "[" {
        step()?
        let ix = parse_expr()?
        want("]")?
        e = ["idx", e, ix]
      } else {
        if peek()[0] == "DOT" {
          step()?
          let meth = step()[1]
          if peek()[1] == "(" {
            step()?
            let mut args = []
            while peek()[1] != ")" {
              args.push(parse_expr()?)
              if peek()[1] == "," {
                step()?
              }
            }
            want(")")?
            if e == ["var", "trace"] && peek()[1] == "{" {
              step()?
              let body = parse_block()?
              want("}")?
              args.push(["closure", ["nul"], [], body])
            }
            e = ["mcall", e, meth, args]
          } else {
            e = ["field", e, meth]
          }
        } else {
          return e
        }
      }
    }
  }
  return e
}
fn parse_prim() -> vec {
  let t = step()?
  if t[0] == "NUM" {
    if t[1].contains(".") {
      return ["num", unwrap(t[1].parse_float())]
    }
    return ["num", unwrap(t[1].parse_int())]
  }
  if t[0] == "STR" {
    return expand_str(unesc(s_slice(t[1], 1, len(t[1]) - 1)))
  }
  if t[0] == "KW" && t[1] in ["true", "false"] {
    return ["bool", t[1] == "true"]
  }
  if t[0] == "ID" && t[1] == "None" {
    return ["none"]
  }
  if t[1] == "[" {
    let mut items = []
    while peek()[1] != "]" {
      items.push(parse_expr()?)
      if peek()[1] == "," {
        step()?
      }
    }
    want("]")?
    return ["vec", items]
  }
  if t[1] == "{" {
    let mut pairs = []
    while peek()[1] != "}" {
      let k = parse_expr()?
      want(":")?
      pairs.push(["@pair", k, parse_expr()?])
      if peek()[1] == "," {
        step()?
      }
    }
    want("}")?
    return ["maplit", pairs]
  }
  if t[0] == "KW" && t[1] == "fn" {
    let mut name = ["nul"]
    if peek()[0] == "ID" && tks[ci + 1][1] == "(" {
      name = step()[1]
    }
  want("(")?
  let params = parse_params()?
  want(")")?
    want("{")?
    let body = parse_block()?
    want("}")?
    return ["closure", name, params, body]
  }
  if t[0] == "ID" || t[0] == "KW" {
    if peek()[1] == "(" {
      step()?
      let mut args = []
      while peek()[1] != ")" {
        args.push(parse_expr()?)
        if peek()[1] == "," {
          step()?
        }
      }
      want(")")?
      return ["call", t[1], args]
    }
    if peek()[1] == "{" && t[0] == "ID" && is_upper(t[1]) {
      step()?
    let mut fields = []
    while peek()[1] != "}" {
        let k = step()[1]
        want(":")?
        fields.push(["@pair", k, parse_expr()?])
        if peek()[1] == "," {
          step()?
        }
      }
      want("}")?
      return ["struct", t[1], fields]
    }
    if t[0] == "ID" && is_upper(t[1]) {
      return ["call", t[1], []]
    }
    return ["var", t[1]]
  }
  if t[1] == "(" {
    let e = parse_expr()?
    want(")")?
    return e
  }
  raise("stuck at " + t[1])
  return ["bad"]
}
fn is_upper(s: str) -> i64 {
  let c = s_slice(s, 0, 1)
  return c >= "A" && c <= "Z"
}
fn esc(s: str) -> str {
  let mut out = ""
  let mut i: i64 = 0
  while i < len(s) {
    let ch = s[i]
    if ch == "\\" {
      out += "\\\\"
    } else {
      if ch == "\"" {
        out += "\\\""
      } else {
        if ch == "\n" {
          out += "\\n"
        } else {
          if ch == "\t" {
            out += "\\t"
          } else {
            if ch == "\r" {
              out += "\\r"
            } else {
              out += ch
            }
          }
        }
      }
    }
    i += 1
  }
  return out
}
let builtins_ = ["print", "log.info", "log.warn", "log.error", "trace.span", "join_all", "len", "__at", "Ok", "Err", "Some", "unwrap", "is_err", "is_none", "is_vec", "is_str", "is_map", "tagof", "str", "read_file", "write_file", "assert", "args", "exit", "eprint", "raise", "time_ms", "sleep_ms", "env_get", "re_match", "tcp_listen", "tcp_accept", "tcp_connect", "tcp_send", "tcp_recv", "tcp_close"]
let copy_anns = ["i32", "i64", "u64", "f64", "bool"]
let mutators_ = ["push", "pop", "sort", "sort_by", "ins", "del", "set"]
let builtin_heads_ = ["log", "trace"]
let mut errl = []
let mut curl: i64 = 0
let mut bidx: i64 = 0
let mut g_heads = {}
let mut g_umeth = {}
fn note(msg: str) {
  errl.push([curl, msg])
}
fn has_path(paths: vec, p: str) -> i64 {
  for x in paths {
    if x == p {
      return 1
    }
  }
  return 0
}
fn add_srcs(acc: vec, srcs: vec) -> vec {
  for s in srcs {
    if !has_path(acc, s) {
      acc.push(s)
    }
  }
  return acc
}
fn is_node(x: vec) -> i64 {
  if !is_vec(x) {
    return 0
  }
  return len(x) > 0 && is_str(x[0])
}
fn scan_kids(e: vec, from: i64) -> vec {
  let mut out = []
  let mut i = from
  while i < len(e) {
    let sub = e[i]
    if is_node(sub) {
      out.push(sub)
    } else {
      if is_vec(sub) {
        for x in sub {
          if is_node(x) {
            out.push(x)
          }
        }
      }
    }
    i += 1
  }
  return out
}
fn place_of(e: vec) -> str {
  if !is_vec(e) || len(e) == 0 {
    return ""
  }
  while len(e) > 1 && e[0] == "quest" {
    e = e[1]
  }
  let k = e[0]
  if k == "var" {
    return e[1]
  }
  if k == "move" {
    return place_of(e[1])
  }
  if k == "field" {
    let b = place_of(e[1])
    if b == "" {
      return ""
    }
    return b + "." + e[2]
  }
  if k == "idx" {
    let b = place_of(e[1])
    if b == "" {
      return ""
    }
    return b + ".*"
  }
  return ""
}
fn alias_owner(name: str, decl: map, depth: i64 = 0) -> str {
  if depth > 32 {
    return name
  }
  let d = decl.get(name)
  if is_none(d) {
    return name
  }
  if d["alias"] != true {
    return name
  }
  let src = d["src"]
  if src != "" && src != name {
    return alias_owner(src, decl, depth + 1)
  }
  return name
}
fn deref_place(e: vec, decl: map, funcs: map) -> vec {
  if !is_node(e) {
    return e
  }
  if len(e) == 3 && e[0] == "call" && is_str(e[1]) && len(e[2]) == 0 {
    let n = e[1]
    if !(n.contains(".")) && (n in decl) && !(n in funcs) {
      return ["var", n]
    }
  }
  return e
}
fn elem_copy(decl: map, base: vec) -> i64 {
  while len(base) > 1 && base[0] == "quest" {
    base = base[1]
  }
  if len(base) == 0 {
    return 0
  }
  let k = base[0]
  if k == "move" || k == "field" || k == "idx" {
    return elem_copy(decl, base[1])
  }
  if k != "var" {
    return 0
  }
  let d = decl.get(base[1])
  if is_none(d) {
    return 0
  }
  let ann = d["ann"]
  if !is_str(ann) || len(ann) == 0 {
    return 0
  }
  let a = ann.trim()
  if a.starts_with("vec[") && a.ends_with("]") {
    a = a.slice(4, len(a) - 1).trim()
  } else {
    if !(a.starts_with("map[") && a.ends_with("]")) {
      return 0
    }
    let ps = a.slice(4, len(a) - 1).split(",")
    a = ps[len(ps) - 1].trim()
  }
  if a in copy_anns {
    return 1
  }
  return 0
}
fn borrow_srcs(e: vec, decl: map, funcs: map) -> vec {
  if !is_vec(e) || len(e) == 0 {
    return []
  }
  while len(e) > 1 && e[0] == "quest" {
    e = e[1]
  }
  if len(e) == 0 {
    return []
  }
  e = deref_place(e, decl, funcs)
  let k = e[0]
  if k == "var" {
    let d = decl.get(e[1])
    if is_none(d) {
      return []
    }
    if d["moved"] {
      return []
    }
    if d["copy"] {
      return []
    }
    let src = d["src"]
    if src != "" && src != e[1] {
      return borrow_srcs(["var", src], decl, funcs)
    }
    return [e[1]]
  }
  if k == "move" {
    return borrow_srcs(e[1], decl, funcs)
  }
  if k == "idx" {
    if elem_copy(decl, e[1]) {
      return []
    }
    return borrow_srcs(e[1], decl, funcs)
  }
  if k == "field" {
    if elem_copy(decl, e[1]) {
      return []
    }
    return borrow_srcs(e[1], decl, funcs)
  }
  if k == "vec" {
    let mut acc = []
    for x in e[1] {
      acc = add_srcs(acc, borrow_srcs(x, decl, funcs))
    }
    return acc
  }
  if k == "maplit" {
    let mut acc = []
    for pr in e[1] {
      acc = add_srcs(acc, borrow_srcs(pr[1], decl, funcs))
      acc = add_srcs(acc, borrow_srcs(pr[2], decl, funcs))
    }
    return acc
  }
  if k == "struct" {
    let mut acc = []
    for pr in e[2] {
      acc = add_srcs(acc, borrow_srcs(pr[2], decl, funcs))
    }
    return acc
  }
  if k == "or" {
    return borrow_srcs(e[1], decl, funcs) + borrow_srcs(e[2], decl, funcs)
  }
  if k == "call" {
    if (e[1] == "ref" || e[1] == "borrow") && !(e[1] in funcs) && len(e[2]) > 0 {
      return borrow_srcs(e[2][0], decl, funcs)
    }
  }
  return []
}
fn escaping_refs(e: vec, decl: map) {
  if !is_vec(e) || len(e) == 0 {
    return
  }
  while len(e) > 1 && e[0] == "quest" {
    e = e[1]
  }
  let k = e[0]
  if k == "var" {
    let d = decl.get(e[1])
    if is_none(d) {
      return
    }
    if d["ref"] {
      let mut root = e[1]
      let mut hops = 0
      let mut param_root = false
      let mut done = false
      while !done {
        let rd = decl.get(root)
        if is_none(rd) {
          done = true
        } else {
          if rd.get_or("param", false) {
            param_root = true
          }
          let nxt = rd["src"]
          if nxt == "" || nxt == root || hops >= 32 {
            done = true
          } else {
            root = nxt
            hops = hops + 1
          }
        }
      }
      if !param_root {
        note("ref `" + e[1] + "` escapes via return")
      }
      return
    }
    let src = d["src"]
    if src != "" && src != e[1] {
      escaping_refs(["var", src], decl)
    }
    return
  }
  if !(k in ["move", "field", "idx", "vec", "maplit", "struct", "or"]) {
    return
  }
  for sub in scan_kids(e, 1) {
    escaping_refs(sub, decl)
  }
}
fn interp_names(s: str) -> vec {
  let mut out = []
  let mut i = 0
  while i < len(s) {
    if s[i] == "{" {
      let mut j = i + 1
      while j < len(s) && s[j] != "}" {
        j = j + 1
      }
      if j < len(s) && j > i + 1 {
        let head = s.slice(i + 1, j).split(".")[0]
        if len(head) > 0 && is_alpha(head[0]) {
          let mut ok = true
          for ch in head {
            if !is_alnum(ch) {
              ok = false
            }
          }
          if ok {
            out.push(head)
          }
        }
      }
      i = j + 1
    } else {
      i = i + 1
    }
  }
  return out
}
fn vars_in(e: vec, acc: vec) -> vec {
  if len(e) == 0 {
    return acc
  }
  let k = e[0]
  if k == "var" {
    acc.push(e[1])
    return acc
  }
  if k in ["num", "bool", "none", "nul"] {
    return acc
  }
  if k == "str" {
    for m in interp_names(e[1]) {
      acc.push(m)
    }
    return acc
  }
  if k == "un" {
    return vars_in(e[2], acc)
  }
  if k == "move" {
    return vars_in(e[1], acc)
  }
  if k == "closure" {
    return acc
  }
  if k == "bin" {
    acc = vars_in(e[2], acc)
    return vars_in(e[3], acc)
  }
  if k == "or" {
    acc = vars_in(e[1], acc)
    return vars_in(e[2], acc)
  }
  if k == "quest" {
    return vars_in(e[1], acc)
  }
  if k == "mcall" {
    acc = vars_in(e[1], acc)
    for a in e[3] {
      acc = vars_in(a, acc)
    }
    return acc
  }
  if k == "vec" {
    for x in e[1] {
      acc = vars_in(x, acc)
    }
    return acc
  }
  if k == "maplit" {
    for pr in e[1] {
      acc = vars_in(pr[1], acc)
      acc = vars_in(pr[2], acc)
    }
    return acc
  }
  if k == "struct" {
    for pr in e[2] {
      acc = vars_in(pr[2], acc)
    }
    return acc
  }
  if k == "field" {
    return vars_in(e[1], acc)
  }
  if k == "idx" {
    acc = vars_in(e[1], acc)
    return vars_in(e[2], acc)
  }
  if k == "call" {
    acc.push(callee_head(e[1]))
    for a in e[2] {
      acc = vars_in(a, acc)
    }
    return acc
  }
  return acc
}
fn wrap_if_node(eb: vec) -> vec {
  if len(eb) > 1 && eb[0] == "@lst2" {
    return [eb[1]]
  }
  if len(eb) > 0 && is_str(eb[0]) {
    return [eb]
  }
  return eb
}
fn used_in_stmt(s: vec, acc: vec) -> vec {
  if len(s) == 0 {
    eprint("EMPTY STMT HIT")
    return acc
  }
  let k = s[0]
  if k == "let" {
    return vars_in(s[2], acc)
  }
  if k == "set" {
    acc.push(s[1].split(".")[0])
    return vars_in(s[2], acc)
  }
  if k == "setidx" {
    acc = vars_in(s[1], acc)
    acc = vars_in(s[2], acc)
    return vars_in(s[3], acc)
  }
  if k == "return" {
    return vars_in(s[1], acc)
  }
  if k == "expr" {
    return vars_in(s[1], acc)
  }
  if k == "if" {
    acc = vars_in(s[1], acc)
    acc = used_in_block(s[2], acc)
    if len(s[3]) > 0 && s[3][0] != "nul" {
      acc = used_in_block(wrap_if_node(s[3]), acc)
    }
    return acc
  }
  if k == "while" {
    acc = vars_in(s[1], acc)
    return used_in_block(s[2], acc)
  }
  if k == "foriter" {
    acc = vars_in(s[2], acc)
    return used_in_block(s[3], acc)
  }
  if k == "forrange" {
    acc = vars_in(s[2], acc)
    acc = vars_in(s[3], acc)
    return used_in_block(s[4], acc)
  }
  if k == "try" {
    acc = used_in_block(s[1], acc)
    return used_in_block(s[2], acc)
  }
  if k == "spawn" {
    return used_in_block(s[1], acc)
  }
  if k == "defer" {
    return vars_in(s[1], acc)
  }
  if k == "impl" {
    for f in s[3] {
      acc = used_in_block(f[3], acc)
    }
    return acc
  }
  if k == "pub" {
    return used_in_stmt(s[1], acc)
  }
  return acc
}
fn used_in_block(body: vec, acc: vec) -> vec {
  for s in body {
    acc = used_in_stmt(s, acc)
  }
  return acc
}
fn is_copy_expr(e: vec, decl: map) -> i64 {
  let k = e[0]
  if k in ["num", "bool"] {
    return 1
  }
  if k == "var" {
    let d = decl.get(e[1])
    if is_none(d) {
      return 0
    }
    return d["copy"]
  }
  if k == "un" {
    return is_copy_expr(e[2], decl)
  }
  if k == "move" {
    return is_copy_expr(e[1], decl)
  }
  if k == "bin" {
    return is_copy_expr(e[2], decl) && is_copy_expr(e[3], decl)
  }
  return 0
}
fn path_of(e: vec) -> str {
  if e[0] == "var" {
    return e[1]
  }
  if e[0] == "field" {
    let b = path_of(e[1])
    if b == "" {
      return ""
    }
    return b + "." + e[2]
  }
  if e[0] == "idx" {
    let b = path_of(e[1])
    if b == "" {
      return ""
    }
    return b + ".*"
  }
  return ""
}
fn write_path(e: vec) -> str {
  if !is_node(e) {
    return ""
  }
  if e[0] == "var" {
    return e[1]
  }
  if e[0] == "field" {
    let b = write_path(e[1])
    if b == "" {
      return ""
    }
    return b + "." + e[2]
  }
  if e[0] == "call" && len(e) == 3 && is_str(e[1]) && len(e[2]) == 0 {
    if is_upper(e[1]) && !e[1].contains(".") {
      return e[1]
    }
  }
  return ""
}
fn paths_conflict(p: str, q: str) -> i64 {
  if p == q {
    return 1
  }
  if p.starts_with(q + ".") || q.starts_with(p + ".") {
    return 1
  }
  if q == p + ".*" || p == q + ".*" {
    return 1
  }
  if q.ends_with(".*") && p.starts_with(q.slice(0, len(q) - 2) + ".") {
    return 1
  }
  if p.ends_with(".*") && q.starts_with(p.slice(0, len(p) - 2) + ".") {
    return 1
  }
  return 0
}
fn moved_targets(e: vec, acc: vec) -> vec {
  if !is_vec(e) || len(e) == 0 {
    return acc
  }
  if e[0] == "move" && len(e) > 1 && is_vec(e[1]) && len(e[1]) > 0 {
    let p = path_of(e[1])
    if p != "" {
      acc.push(p)
      return acc
    }
  }
  let mut i: i64 = 1
  while i < len(e) {
    let sub = e[i]
    if is_node(sub) {
      acc = moved_targets(sub, acc)
    } else {
      if is_vec(sub) {
        for x in sub {
          if is_vec(x) {
            acc = moved_targets(x, acc)
          }
        }
      }
    }
    i += 1
  }
  return acc
}
fn scan_moves(e: vec, decl: map, borrows: map) {
  for v in moved_targets(e, []) {
    let root = v.split(".")[0]
    let d = decl.get(root)
    if is_none(d) {
      continue
    }
    if d["moved"] {
      note("use of moved `" + root + "`")
      continue
    }
    let mut conf = false
    for mp in d["moved_paths"] {
      if paths_conflict(v, mp) {
        conf = true
      }
    }
    if conf {
      note("use of moved `" + v + "`")
      continue
    }
    if root in borrows && len(borrows[root]) > 0 {
      let live = borrows[root]
      note("cannot move `" + v + "` while borrowed by `" + live[len(live) - 1][0] + "`")
      continue
    }
    if v == root {
      d["moved"] = true
      d["moved_line"] = curl
    } else {
      d["moved_paths"] = d["moved_paths"] + [v]
    }
  }
}
fn mutate_kind(meth: str) -> str {
  if meth in g_umeth {
    if g_umeth[meth] {
      return "mut self"
    }
    return ""
  }
  if meth in mutators_ {
    return "builtin"
  }
  return ""
}
fn check_mutate(path: str, decl: map, borrows: map, kind: str, who: str) -> i64 {
  let root = path.split(".")[0]
  let d = decl.get(root)
  if is_none(d) {
    return 0
  }
  if d["const"] {
    note("assign to const `" + path + "`")
    return 0
  }
  if d["moved"] {
    note("use of moved `" + root + "`")
    return 0
  }
  if d["mut"] != true {
    if kind == "mut self" {
      note("cannot mutate immutable `" + root + "`: `" + who + "` takes mut self")
    } else {
      note("cannot mutate immutable `" + root + "`: `" + who + "` writes through it")
    }
    return 0
  }
  if root in borrows && len(borrows[root]) > 0 {
    let live = borrows[root]
    note("cannot mutate immutable `" + root + "` while borrowed by `" + live[len(live) - 1][0] + "`")
    return 0
  }
  return 1
}
fn claim_loe(path: str, who: str, claimed: vec) -> i64 {
  for other in claimed {
    if paths_conflict(path, other[0]) {
      note("law of exclusivity: `" + path + "` passed as mut twice in one expression (clashes with `" + other[0] + "` used by `" + other[1] + "`)")
      return 0
    }
  }
  return 1
}
fn check_write(path: str, decl: map, borrows: map, rebind: i64 = 0, strict: i64 = 1) -> i64 {
  let root = path.split(".")[0]
  let d = decl.get(root)
  if is_none(d) {
    return 1
  }
  if d["const"] {
    note("assign to const `" + path + "`")
    return 0
  }
  if d["moved"] {
    note("use of moved `" + root + "`")
    return 0
  }
  if d.get("spawn_frozen") && rebind {
    note("assign to captured `" + root + "` in spawn (captured by copy, write is lost)")
    return 0
  }
  if strict && d["mut"] != true {
    note("assign to immutable `" + root + "` (want `let mut` or mut param)")
    return 0
  }
  if !rebind {
    let own = alias_owner(root, decl)
    if own != root {
      let od = decl.get(own)
      if !is_none(od) {
        if od["const"] {
          note("assign to const `" + path + "` through alias `" + root + "`")
          return 0
        }
        if od["mut"] != true {
          note("write through `" + root + "` mutates immutable `" + own + "`")
          return 0
        }
        if od["mut"] {
          note("double mut borrow of `" + own + "`: write through alias `" + root + "` is a second mutable place")
          return 0
        }
      }
    }
  }
  if root in borrows && len(borrows[root]) > 0 {
    let live = borrows[root]
    note("cannot assign `" + root + "` while borrowed by `" + live[len(live) - 1][0] + "`")
    return 0
  }
  return 1
}
fn scan_calls(e: vec, decl: map, borrows: map, sigs: map, claimed: vec) {
  if !is_node(e) {
    return
  }
  let k = e[0]
  if k == "call" && e[1] in sigs {
    let modes = sigs[e[1]]
    let mut i: i64 = 0
    while i < len(modes) && i < len(e[2]) {
      let pn = modes[i][0]
      let mode = modes[i][1]
      let mut arg = e[2][i]
      while len(arg) > 1 && arg[0] == "quest" {
        arg = arg[1]
      }
      if (mode == "mut" || mode == "move") && len(arg) > 0 {
        let p = place_of(arg)
        if p != "" && claim_loe(p, pn, claimed) {
          claimed.push([p, pn])
        }
        let whole = arg[0] == "var"
        if whole || (arg[0] == "field" && p != "") {
          let mut v = ""
          if whole {
            v = arg[1]
          } else {
            v = p.split(".")[0]
          }
          let d = decl.get(v)
          let mut live: vec = []
          if v in borrows {
            live = borrows[v]
          }
          if mode == "mut" {
            if !is_none(d) && d["mut"] != true {
              note("pass immutable `" + v + "` as mut param `" + pn + "`")
            } else {
              if !is_none(d) && d["moved"] {
                note("use of moved `" + v + "`")
              } else {
                if len(live) > 0 {
                  note("cannot pass `" + v + "` as mut while borrowed by `" + live[len(live) - 1][0] + "`")
                }
              }
            }
          } else {
            if !is_none(d) && d["moved"] {
              note("use of moved `" + v + "`")
            } else {
              if len(live) > 0 {
                note("cannot move `" + v + "` while borrowed by `" + live[len(live) - 1][0] + "`")
              } else {
                if !is_none(d) && whole {
                  let mut conf = false
                  for mp in d["moved_paths"] {
                    if paths_conflict(v, mp) {
                      conf = true
                    }
                  }
                  if conf {
                    note("use of moved `" + v + "`")
                  } else {
                    d["moved"] = true
                    d["moved_line"] = curl
                  }
                }
              }
            }
          }
        }
      }
      i += 1
    }
  } else {
    if k == "mcall" {
      let kind = mutate_kind(e[2])
      if kind != "" {
        let b = deref_place(e[1], decl, sigs)
        let bp = write_path(b)
        let mut p = ""
        let mut who = e[2]
        if bp != "" {
          p = bp.split(".")[0]
          who = bp + "." + e[2]
        } else {
          p = path_of(b)
        }
        if p != "" && check_mutate(p, decl, borrows, kind, who) && claim_loe(p, who, claimed) {
          claimed.push([p, who])
        }
      }
    }
  }
  for sub in scan_kids(e, 1) {
    scan_calls(sub, decl, borrows, sigs, claimed)
  }
}
fn callee_head(name: str) -> str {
  if is_str(name) && name.contains(".") {
    return name.split(".")[0]
  }
  return name
}
fn callee_known(name: str, decl: map, funcs: map) -> i64 {
  if !is_str(name) {
    return 1
  }
  if name in funcs {
    return 1
  }
  if name in builtins_ {
    return 1
  }
  if !name.contains(".") {
    if name in decl {
      return 1
    }
    return 0
  }
  let head = name.split(".")[0]
  if head in decl {
    return 1
  }
  if head in funcs {
    return 1
  }
  if head in builtin_heads_ {
    return 1
  }
  if head in g_heads {
    return 1
  }
  return 0
}
fn check_expr(e: vec, decl: map, funcs: map, inpath: i64 = 0) {
  if len(e) == 0 {
    return
  }
  let k = e[0]
  if k == "var" {
    if !(e[1] in decl) && !(e[1] in funcs) {
      note("use of undeclared var `" + e[1] + "`")
    } else {
      if e[1] in decl && decl[e[1]]["moved"] {
        note("use of moved `" + e[1] + "` (hint: the value was moved; use a copy or re-bind)")
      } else {
        if e[1] in decl && decl[e[1]]["frozen_by"] != "" {
          note("cannot use `" + e[1] + "` while mutably borrowed by `" + decl[e[1]]["frozen_by"] + "`")
        }
      }
    }
    return
  }
  if k in ["num", "str", "bool", "none", "nul"] {
    return
  }
  if k == "un" {
    check_expr(e[2], decl, funcs)
    return
  }
  if k == "move" {
    check_expr(e[1], decl, funcs)
    return
  }
  if k == "closure" {
    walk_closure_arg(e, decl, funcs)
  }
  if k == "bin" {
    check_expr(e[2], decl, funcs)
    check_expr(e[3], decl, funcs)
    return
  }
  if k == "or" {
    check_expr(e[1], decl, funcs)
    check_expr(e[2], decl, funcs)
    return
  }
  if k == "quest" {
    check_expr(e[1], decl, funcs)
    return
  }
  if k == "mcall" {
    let bp = write_path(deref_place(e[1], decl, funcs))
    if bp == "" || !callee_known(bp + "." + e[2], decl, funcs) {
      check_expr(e[1], decl, funcs)
    }
    for a in e[3] {
      check_expr(a, decl, funcs)
    }
    return
  }
  if k == "vec" {
    for x in e[1] {
      check_expr(x, decl, funcs)
    }
    return
  }
  if k == "maplit" {
    for pr in e[1] {
      check_expr(pr[1], decl, funcs)
      check_expr(pr[2], decl, funcs)
    }
    return
  }
  if k == "struct" {
    for pr in e[2] {
      check_expr(pr[2], decl, funcs)
    }
    return
  }
  if k == "field" {
    check_expr(e[1], decl, funcs, true)
    let p = path_of(e)
    if p != "" && !inpath {
      let d = decl.get(p.split(".")[0])
      if !is_none(d) && !d["moved"] {
        for mp in d["moved_paths"] {
          if paths_conflict(p, mp) {
            note("use of moved `" + p + "`")
          }
        }
      }
    }
    return
  }
  if k == "idx" {
    check_expr(e[1], decl, funcs, true)
    check_expr(e[2], decl, funcs)
    let p = path_of(e)
    if p != "" && !inpath {
      let d = decl.get(p.split(".")[0])
      if !is_none(d) && !d["moved"] {
        for mp in d["moved_paths"] {
          if paths_conflict(p, mp) {
            note("use of moved `" + p + "`")
          }
        }
      }
    }
    return
  }
  if k == "call" {
    for a in e[2] {
      check_expr(a, decl, funcs)
    }
    if !callee_known(e[1], decl, funcs) {
      note("use of undeclared var `" + callee_head(e[1]) + "`")
    }
    return
  }
}
fn walk_closure_arg(a: vec, decl: map, funcs: map) {
  if is_node(a) && a[0] == "closure" {
    let mut sub = {}
    for n in decl.keys() {
      sub[n] = decl[n]
    }
    if is_str(a[1]) && a[1] != "" {
      sub[a[1]] = bare_decl()
    }
    for p in a[2] {
      sub[p[1]] = param_decl(p)
    }
    walk_block(a[3], sub, {}, funcs)
  }
}
fn bare_decl() -> map {
  return {"mut": false, "ref": false, "src": "", "srcs": [], "moved": false, "moved_line": 0, "const": false, "alias": false, "copy": false, "pinned": false, "frozen_by": "", "moved_paths": [], "ann": ""}
}
fn param_decl(p: vec) -> map {
  let d = bare_decl()
  d["mut"] = p[2] == "mut"
  d["copy"] = p[3] in copy_anns
  d["param"] = true
  if is_str(p[3]) {
    d["ann"] = p[3]
  }
  return d
}
fn copy_decl(decl: map) -> map {
  let mut out = {}
  for n in decl.keys() {
    let d = decl[n]
    let c = bare_decl()
    c["mut"] = d["mut"]
    c["ref"] = d["ref"]
    c["src"] = d["src"]
    c["srcs"] = d["srcs"].copy()
    c["moved"] = d["moved"]
    c["moved_line"] = d["moved_line"]
    c["const"] = d["const"]
    c["alias"] = d["alias"]
    c["copy"] = d["copy"]
    c["pinned"] = d["pinned"]
    c["frozen_by"] = d["frozen_by"]
    c["ann"] = d["ann"]
    for mp in d["moved_paths"] {
      c["moved_paths"] = c["moved_paths"] + [mp]
    }
    out[n] = c
  }
  return out
}
fn copy_borrows(borrows: map) -> map {
  let mut out = {}
  for src in borrows.keys() {
    let mut lst = []
    for bm in borrows[src] {
      lst.push(bm)
    }
    out[src] = lst
  }
  return out
}
fn merge_moved(decl: map, post: map) {
  for n in post.keys() {
    if !(n in decl) {
      continue
    }
    let d = post[n]
    let t = decl[n]
    if d["moved"] && t["moved"] != true {
      t["moved"] = true
      t["moved_line"] = d["moved_line"]
    }
    for mp in d["moved_paths"] {
      if !has_path(t["moved_paths"], mp) {
        t["moved_paths"] = t["moved_paths"] + [mp]
      }
    }
  }
}
fn loop_pass(body: vec, decl: map, borrows: map, funcs: map, varname: str) -> map {
  let sub = copy_decl(decl)
  if varname != "" {
    sub[varname] = bare_decl()
  }
  walk_block(body, sub, copy_borrows(borrows), funcs)
  return sub
}
fn moved_fingerprint(decl: map) -> vec {
  let mut out = []
  for n in decl.keys() {
    let d = decl[n]
    out.push(n + ":" + str(d["moved"]) + ":" + str(d.get_or("moved_paths", [])))
  }
  out.sort()
  return out
}
fn walk_loop(body: vec, decl: map, borrows: map, funcs: map, varname: str = "") {
  let before = moved_fingerprint(decl)
  merge_moved(decl, loop_pass(body, decl, borrows, funcs, varname))
  if moved_fingerprint(decl) != before {
    merge_moved(decl, loop_pass(body, decl, borrows, funcs, varname))
  }
}
fn walk_block(body: vec, decl: map, borrows: map, funcs: map) {
  let mut last = {}
  let mut i: i64 = 0
  while i < len(body) {
    if len(body[i]) == 0 {
      eprint("empty at body idx ", i, " of ", len(body))
    }
    for v in used_in_stmt(body[i], []) {
      last[v] = i
    }
    i += 1
  }
  let defers = []
  i = 0
  while i < len(body) {
    bidx = i
    for src in borrows.keys().copy() {
      let kept = []
      for bm in borrows[src] {
        if !(bm[0] in decl) || last.get_or(bm[0], bm[3]) >= i {
          kept.push(bm)
        }
      }
      if len(kept) > 0 {
        borrows[src] = kept
      } else {
        borrows.del(src)
      }
    }
    for name in decl.keys() {
      decl[name]["frozen_by"] = ""
    }
    for src in borrows.keys() {
      for bm in borrows[src] {
        if bm[1] && src in decl {
          decl[src]["frozen_by"] = bm[0]
        }
      }
    }
    walk_stmt(body[i], decl, borrows, funcs)
    if len(body[i]) > 0 && body[i][0] == "defer" {
      defers.push(body[i][1])
    }
    i += 1
  }
  let mut j = len(defers) - 1
  while j >= 0 {
    scan_moves(defers[j], decl, borrows)
    j -= 1
  }
}
fn walk_stmt(s: vec, decl: map, borrows: map, funcs: map) {
  let ln = s[len(s) - 1]
  if is_map(ln) && "ln" in ln {
    curl = ln["ln"]
  }
  let k = s[0]
  if k == "let" {
    let name = s[1]
    let e = s[2]
    let mut_ = len(s) > 3 && s[3] == true
    check_expr(e, decl, funcs)
    scan_moves(e, decl, borrows)
    scan_calls(e, decl, borrows, funcs, [])
    let srcs = borrow_srcs(e, decl, funcs)
    let place = place_of(e)
    let elem = place != "" && place.contains(".")
    let hm = mut_ && !elem
    for src in srcs {
      if !(src in borrows) {
        borrows[src] = []
      }
      let prev = borrows[src]
      let mut anymut = false
      for t in prev {
        if t[1] {
          anymut = true
        }
      }
      if len(prev) > 0 && (hm || anymut) {
        note("double mut borrow of `" + src + "`: `" + name + "` clashes with `" + prev[len(prev) - 1][0] + "`")
      }
      prev.push([name, hm, curl, bidx])
      borrows[src] = prev
    }
    if mut_ && !elem {
      for src in srcs {
        let sd = decl.get(src)
        if is_none(sd) {
          continue
        }
        if sd["const"] {
          note("assign to const `" + src + "` through mut borrow `" + name + "`")
        } else {
          if sd["mut"] != true {
            note("cannot borrow immutable `" + src + "` as mut (`let mut " + name + "`)")
          }
        }
      }
    }
    let mut ann = ""
    if len(s) > 5 && is_str(s[5]) {
      ann = s[5]
    }
    let mut src = ""
    if len(srcs) > 0 {
      src = srcs[0]
    }
    let mut alias = false
    if len(srcs) == 1 && place != "" {
      alias = true
    }
    let d = bare_decl()
    d["mut"] = mut_
    d["ref"] = len(srcs) > 0 && !elem
    d["src"] = src
    d["srcs"] = srcs
    d["const"] = len(s) > 4 && s[4] == true
    d["alias"] = alias
    d["copy"] = ann in copy_anns || is_copy_expr(e, decl)
    d["pinned"] = ann in copy_anns
    d["ann"] = ann
    decl[name] = d
    return
  }
  if k == "set" {
    check_expr(s[2], decl, funcs)
    scan_moves(s[2], decl, borrows)
    scan_calls(s[2], decl, borrows, funcs, [])
    let tgt = s[1].split(".")[0]
    if !(tgt in decl) {
      note("use of undeclared var `" + s[1] + "`")
      return
    }
    if check_write(s[1], decl, borrows, 1, 1) {
      decl[tgt]["moved"] = false
      if decl[tgt]["pinned"] && is_copy_expr(s[2], decl) {
        decl[tgt]["copy"] = true
      } else {
        decl[tgt]["copy"] = is_copy_expr(s[2], decl)
        decl[tgt]["pinned"] = false
      }
      if !s[1].contains(".") {
        decl[tgt]["moved_paths"] = []
      } else {
        let mut kept = []
        for mp in decl[tgt]["moved_paths"] {
          if !paths_conflict(s[1], mp) {
            kept.push(mp)
          }
        }
        decl[tgt]["moved_paths"] = kept
      }
    }
    return
  }
  if k == "setidx" {
    check_expr(s[1], decl, funcs)
    check_expr(s[2], decl, funcs)
    check_expr(s[3], decl, funcs)
    scan_moves(s[3], decl, borrows)
    scan_calls(s[3], decl, borrows, funcs, [])
    let base = path_of(deref_place(s[1], decl, funcs))
    if base == "" {
      return
    }
    let tgt = base.split(".")[0]
    if !(tgt in decl) {
      note("use of undeclared var `" + base + "`")
      return
    }
    check_write(base, decl, borrows, 0, 1)
    return
  }
  if k == "setfield" {
    let b = deref_place(s[1], decl, funcs)
    let base = write_path(b)
    if base != "" {
      walk_stmt(["set", base + "." + s[2], s[3]], decl, borrows, funcs)
      return
    }
    check_expr(s[1], decl, funcs, true)
    check_expr(s[3], decl, funcs)
    scan_moves(s[3], decl, borrows)
    scan_calls(s[3], decl, borrows, funcs, [])
    let base2 = path_of(b)
    if base2 == "" {
      return
    }
    let p = base2 + "." + s[2]
    let tgt = p.split(".")[0]
    if !(tgt in decl) {
      note("use of undeclared var `" + base2 + "`")
      return
    }
    check_write(p, decl, borrows, 0, 0)
    return
  }
  if k == "return" {
    if in_spawn > 0 {
      note("return escapes spawn")
    }
    check_expr(s[1], decl, funcs)
    scan_moves(s[1], decl, borrows)
    scan_calls(s[1], decl, borrows, funcs, [])
    escaping_refs(s[1], decl)
    return
  }
  if k == "expr" {
    check_expr(s[1], decl, funcs)
    scan_moves(s[1], decl, borrows)
    scan_calls(s[1], decl, borrows, funcs, [])
    return
  }
  if k == "fn" {
    let sub = decl.copy()
    for p in s[2] {
      sub[p[1]] = param_decl(p)
    }
    walk_block(s[3], sub, {}, funcs)
    return
  }
  if k == "if" {
    check_expr(s[1], decl, funcs)
    scan_moves(s[1], decl, borrows)
    scan_calls(s[1], decl, borrows, funcs, [])
    let pre = copy_decl(decl)
    walk_block(s[2], pre, copy_borrows(borrows), funcs)
    if len(s[3]) > 0 && s[3][0] != "nul" {
      let post = copy_decl(decl)
      walk_block(wrap_if_node(s[3]), post, copy_borrows(borrows), funcs)
      merge_moved(pre, post)
    }
    merge_moved(decl, pre)
    return
  }
  if k == "while" {
    check_expr(s[1], decl, funcs)
    scan_moves(s[1], decl, borrows)
    scan_calls(s[1], decl, borrows, funcs, [])
    walk_loop(s[2], decl, borrows, funcs)
    return
  }
  if k == "foriter" {
    check_expr(s[2], decl, funcs)
    scan_moves(s[2], decl, borrows)
    scan_calls(s[2], decl, borrows, funcs, [])
    walk_loop(s[3], decl, borrows, funcs, s[1])
    return
  }
  if k == "forrange" {
    check_expr(s[2], decl, funcs)
    scan_moves(s[2], decl, borrows)
    scan_calls(s[2], decl, borrows, funcs, [])
    check_expr(s[3], decl, funcs)
    scan_moves(s[3], decl, borrows)
    scan_calls(s[3], decl, borrows, funcs, [])
    walk_loop(s[4], decl, borrows, funcs, s[1])
    return
  }
  if k in ["break", "continue", "import", "trait"] {
    return
  }
  if k == "enum" {
    for vr in s[2] {
      funcs[vr[1]] = []
    }
    return
  }
  if k == "try" {
    let pre = copy_decl(decl)
    walk_block(s[1], pre, copy_borrows(borrows), funcs)
    let hdecl = copy_decl(decl)
    if len(s) > 3 && is_str(s[3]) && s[3] != "" && s[3] != "nul" {
      hdecl[s[3]] = bare_decl()
    }
    walk_block(s[2], hdecl, copy_borrows(borrows), funcs)
    merge_moved(pre, hdecl)
    merge_moved(decl, pre)
    return
  }
  if k == "spawn" {
    let mut seen = {}
    for v in used_in_block(s[1], []) {
      let d = decl.get(v)
      if !is_none(d) && d["ref"] && !(v in seen) {
        seen[v] = 1
        note("ref `" + v + "` escapes via spawn")
      }
    }
    let sub = copy_decl(decl)
    for kk in sub.keys() {
      sub[kk]["spawn_frozen"] = true
    }
    in_spawn += 1
    walk_block(s[1], sub, copy_borrows(borrows), funcs)
    in_spawn -= 1
    merge_moved(decl, sub)
    return
  }
  if k == "defer" {
    check_expr(s[1], decl, funcs)
    scan_calls(s[1], decl, borrows, funcs, [])
    return
  }
  if k == "impl" {
    let mut seen = {}
    for f in s[3] {
      if f[1] in seen {
        note("duplicate method `" + s[2] + "." + f[1] + "`")
      }
      seen[f[1]] = 1
      let sub = decl.copy()
      for p in f[2] {
        sub[p[1]] = param_decl(p)
      }
      walk_block(f[3], sub, {}, funcs)
    }
    return
  }
  if k == "pub" {
    walk_stmt(s[1], decl, borrows, funcs)
    return
  }
}
let mut in_spawn: i64 = 0
fn scan_type_names(node: vec, heads: map) {
  if !is_node(node) {
    if is_vec(node) {
      for x in node {
        scan_type_names(x, heads)
      }
    }
    return
  }
  if node[0] == "struct" && is_str(node[1]) {
    heads[node[1]] = 1
  }
  let mut i: i64 = 1
  while i < len(node) {
    let sub = node[i]
    if is_node(sub) {
      scan_type_names(sub, heads)
    } else {
      if is_vec(sub) {
        for x in sub {
          scan_type_names(x, heads)
        }
      }
    }
    i += 1
  }
}
fn collect_heads(prog: vec, heads: map, umeth: map) {
  for s in prog[1] {
    if s[0] == "import" {
      let parts = str(s[1]).split(".")
      let mut acc = ""
      for part in parts {
        if acc == "" {
          acc = part
        } else {
          acc = acc + "." + part
        }
        heads[acc] = 1
      }
    }
    let mut node = s
    if s[0] == "pub" {
      node = s[1]
    }
    if len(node) > 0 && node[0] == "impl" {
      heads[node[2]] = 1
      for f in node[3] {
        let ps = f[2]
        if len(ps) > 0 && is_node(ps[0]) && ps[0][1] == "self" {
          if f[1] in mutators_ && ps[0][2] != "mut" {
            continue
          }
          let take = ps[0][2] == "mut"
          if f[1] in umeth {
            if umeth[f[1]] {
              take = true
            }
          }
          umeth[f[1]] = take
        }
      }
    } else {
      if len(node) > 0 && node[0] == "enum" {
        heads[node[1]] = 1
      }
    }
  }
  scan_type_names(prog[1], heads)
}
fn check(prog: vec, extra: map) {
  let mut funcs = extra.copy()
  let mut traits = {}
  for s in prog[1] {
    let node = s
    if s[0] == "pub" {
      node = s[1]
    }
    if node[0] == "fn" {
      let modes = []
      for p in node[2] {
        modes.push([p[1], p[2]])
      }
      funcs[node[1]] = modes
    }
    if node[0] == "enum" {
      for vr in node[2] {
        funcs[vr[1]] = []
      }
    }
    if node[0] == "trait" {
      let ms = []
      for g in node[2] {
        ms.push(g[1])
      }
      traits[node[1]] = ms
    }
  }
  g_heads = {}
  g_umeth = {}
  collect_heads(prog, g_heads, g_umeth)
  for s in prog[1] {
    let mut rnode = s
    if s[0] == "pub" {
      rnode = s[1]
    }
    if is_node(rnode) && len(rnode) > 0 && rnode[0] == "impl" {
      let iln2 = rnode[len(rnode) - 1]
      if is_map(iln2) && "ln" in iln2 {
        curl = iln2["ln"]
      }
      for f in rnode[3] {
        let ps2 = f[2]
        let mut ismut = false
        if len(ps2) > 0 && is_node(ps2[0]) && ps2[0][1] == "self" && ps2[0][2] == "mut" {
          ismut = true
        }
        if f[1] in mutators_ && !ismut {
          note("method name " + f[1] + " is reserved (built-in mutator)")
        }
      }
    }
  }
  for s in prog[1] {
    let mut node = s
    if s[0] == "pub" {
      node = s[1]
    }
    if len(node) > 0 && node[0] == "impl" && node[1][0] != "nul" {
      if !(node[1] in traits) {
        let iln = node[len(node) - 1]
        if is_map(iln) && "ln" in iln {
          curl = iln["ln"]
        }
        note("unknown trait " + node[1] + " (declare it with `trait " + node[1] + " { ... }`)")
      } else {
        for m in traits.get_or(node[1], []) {
          let mut have = false
          for f in node[3] {
            if f[1] == m {
              have = true
            }
          }
          if !have {
            note("impl " + node[1] + " for " + node[2] + " missing " + m)
          }
        }
      }
    }
  }
  walk_block(prog[1], {}, {}, funcs)
}
fn report(f: str, src: str) {
  let lines = src.split("\n")
  for e in errl {
    let ln = e[0]
    let msg = e[1]
    if ln > 0 && ln <= len(lines) {
      print(f + ":" + str(ln) + ": error: " + msg)
      print("  | " + lines[ln - 1].trim())
    } else {
      print(f + ": error: " + msg)
    }
  }
}
let mut files_ = []
let mut seen_ = {}
let mut srcs_ = {}
fn dir_of(path: str) -> str {
  let p = path.replace("\\", "/").split("/")
  if len(p) > 1 {
    return p.slice(0, len(p) - 1).join("/")
  }
  return "."
}
fn add_file(f: str) {
  if f in seen_ {
    return
  }
  seen_[f] = 1
  let src = read_file(f)?
  srcs_[f] = src
  tks = lex(src)
  ci = 0
  seq = 0
  let mut body = []
  while peek()[0] != "EOF" {
    let st = parse_stmt()?
    if st[0] == "@lst" {
      for x in st[1] {
        body.push(x)
      }
    } else {
      body.push(st)
    }
  }
  files_.push([f, ["prog", body]])
  for s in body {
    if s[0] == "import" {
      add_file(dir_of(f) + "/" + s[1].replace(".", "/") + ".brat")
    }
  }
}
fn dedupe_errs() {
  let mut uniq = []
  for e in errl {
    let mut dup = false
    for u in uniq {
      if u[0] == e[0] && u[1] == e[1] {
        dup = true
      }
    }
    if !dup {
      uniq.push(e)
    }
  }
  errl = uniq
}
fn main() -> i64 {
  let a = args()
  if len(a) == 0 {
    print("usage: bratb file.brat")
    return 0
  }
  add_file(a[0])?
  let mut merged = {}
  let mut first = true
  for fp in files_ {
    if first {
      first = false
      continue
    }
    let prog = fp[1]
    for s in prog[1] {
      if s[0] == "pub" {
        let node = s[1]
        if node[0] == "fn" {
          let modes = []
          for p in node[2] {
            modes.push([p[1], p[2]])
          }
          merged[node[1]] = modes
        }
        if node[0] == "enum" {
          for vr in node[2] {
            merged[vr[1]] = []
          }
        }
      }
    }
  }
  let mut code = 0
  for fp in files_ {
    let f = fp[0]
    let prog = fp[1]
    errl = []
    check(prog, merged)
    dedupe_errs()
    print(f + ": " + str(len(errl)) + " error(s)")
    report(f, srcs_[f])
    if len(errl) > 0 {
      code = 1
    }
  }
  return code
}
fn esc(s: str) -> str {
  let mut out = ""
  let mut i: i64 = 0
  while i < len(s) {
    let ch = s[i]
    if ch == "\\" {
      out += "\\\\"
    } else {
      if ch == "\"" {
        out += "\\\""
      } else {
        if ch == "\n" {
          out += "\\n"
        } else {
          if ch == "\t" {
            out += "\\t"
          } else {
            if ch == "\r" {
              out += "\\r"
            } else {
              out += ch
            }
          }
        }
      }
    }
    i += 1
  }
  return out
}
let tagset = ["prog", "let", "set", "setidx", "setfield", "fn", "if", "while", "forrange", "foriter", "return", "try", "spawn", "defer", "break", "continue", "import", "pub", "enum", "trait", "impl", "sig", "expr", "or", "bin", "un", "move", "quest", "mcall", "call", "idx", "field", "struct", "maplit", "closure", "vec", "num", "str", "bool", "none", "var", "lit", "variant", "wild", "bind", "sig2"]
fn sexp(n) -> str {
  if is_vec(n) {
    if len(n) == 0 {
      return "[]"
    }
    let head = n[0]
    if is_str(head) && (head in tagset || head == "nul") {
      if head == "nul" {
        return "None"
      }
      let mut out = "("
      let mut i: i64 = 0
      while i < len(n) {
        if i > 0 {
          out += " "
        }
        out += sexp(n[i])
        i += 1
      }
      return out + ")"
    }
    if is_str(head) && head == "@grp" {
      let mut out = "["
      let mut i: i64 = 0
      while i < len(n[1]) {
        if i > 0 {
          out += " "
        }
        out += sexp(n[1][i])
        i += 1
      }
      return out + "]"
    }
    if is_str(head) && head == "@lst" {
      let mut out = ""
      for x in n[1] {
        out += sexp(x) + " "
      }
      return out
    }
    if is_str(head) && head == "@lst2" {
      return sexp(n[1])
    }
    if is_str(head) && head == "@pair" {
      let mut out = "("
      let mut i: i64 = 1
      while i < len(n) {
        if i > 1 {
          out += " "
        }
        out += sexp(n[i])
        i += 1
      }
      return out + ")"
    }
    let mut out = "["
    let mut i2: i64 = 0
    while i2 < len(n) {
      if i2 > 0 {
        out += " "
      }
      out += sexp(n[i2])
      i2 += 1
    }
    return out + "]"
  }
  if is_none(n) {
    return "None"
  }
  if is_str(n) {
    return "\"" + esc(n) + "\""
  }
  return str(n)
}
