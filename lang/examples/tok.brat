fn is_digit(ch: str) -> i64 {
  if ch >= "0" {
    if ch <= "9" {
      return 1
    }
  }
  return 0
}
fn is_alpha(ch: str) -> i64 {
  if ch >= "a" {
    if ch <= "z" {
      return 1
    }
  }
  if ch >= "A" {
    if ch <= "Z" {
      return 1
    }
  }
  if ch == "_" {
    return 1
  }
  return 0
}
fn is_space(ch: str) -> i64 {
  if ch == " " {
    return 1
  }
  if ch == "\n" {
    return 1
  }
  return 0
}
fn lex(src: str) -> i64 {
  let mut toks = []
  let mut i: i64 = 0
  while i < len(src) {
    let ch = src[i]
    if is_space(ch) {
      i = i + 1
    } else {
      if is_digit(ch) {
        let mut j = i
        while j < len(src) {
          if is_digit(src[j]) {
            j = j + 1
          } else {
            break
          }
        }
        toks.push("num")
        i = j
      } else {
        if is_alpha(ch) {
          let mut j = i
          while j < len(src) {
            if is_alpha(src[j]) {
              j = j + 1
            } else {
              break
            }
          }
          toks.push("id")
          i = j
        } else {
          toks.push("op")
          i = i + 1
        }
      }
    }
  }
  print(len(toks))
  print(toks[0])
  print(toks[1])
  return len(toks)
}
fn main() -> i64 {
  let mut src = "let x = 40 + 2\nprint(x)\n"
  let got = read_file("tok_sample.brat")
  match tagof(got) {
    "ok" => {
      src = got[1]
    },
    _ => {
      print("embedded")
    }
  }
  let n = lex(src)?
  return 0
}
