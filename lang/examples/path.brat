pub fn path_rfind(p: str, ch: str) -> i64 {
  let mut i = len(p) - 1
  while i >= 0 {
    if p[i] == ch {
      return i
    }
    i -= 1
  }
  return -1
}
pub fn path_join(a: str, b: str) -> str {
  if len(a) == 0 {
    return b
  }
  if len(b) == 0 {
    return a
  }
  if a.ends_with("/") {
    return a + b
  }
  return a + "/" + b
}
pub fn path_dir(p: str) -> str {
  let i = path_rfind(p, "/")
  if i < 0 {
    return ""
  }
  if i == 0 {
    return "/"
  }
  return p.slice(0, i)
}
pub fn path_base(p: str) -> str {
  let i = path_rfind(p, "/")
  if i < 0 {
    return p
  }
  return p.slice(i + 1, len(p))
}
pub fn path_ext(p: str) -> str {
  let b = path_base(p)
  let i = path_rfind(b, ".")
  if i <= 0 {
    return ""
  }
  return b.slice(i, len(b))
}
pub fn path_norm(p: str) -> str {
  let abs = p.starts_with("/")
  let mut parts = []
  for seg in p.split("/") {
    if seg == "" || seg == "." {
      continue
    }
    if seg == ".." {
      if len(parts) > 0 && parts[len(parts) - 1] != ".." {
        parts = parts.slice(0, len(parts) - 1)
      } else {
        if !abs {
          parts.push("..")
        }
      }
      continue
    }
    parts.push(seg)
  }
  let mut out = ""
  for seg in parts {
    out += "/" + seg
  }
  if !abs && len(out) > 0 {
    out = out.slice(1, len(out))
  }
  if len(out) == 0 {
    if abs {
      return "/"
    }
    return "."
  }
  return out
}
fn path_expect(cond: bool, name: str) -> i64 {
  if cond {
    print("ok " + name)
  } else {
    print("FAIL " + name)
    return 1
  }
  return 0
}
fn main() -> i64 {
  let mut bad = 0
  bad += path_expect(path_join("a", "b") == "a/b", "join plain")
  bad += path_expect(path_join("", "b") == "b", "join empty left")
  bad += path_expect(path_join("a", "") == "a", "join empty right")
  bad += path_expect(path_join("a/", "b") == "a/b", "join trailing slash")
  bad += path_expect(path_join("/", "a") == "/a", "join root")
  bad += path_expect(path_join("a", "b/c") == "a/b/c", "join deep right")
  bad += path_expect(path_dir("a/b/c") == "a/b", "dir plain")
  bad += path_expect(path_dir("a") == "", "dir no slash")
  bad += path_expect(path_dir("a/b/") == "a/b", "dir trailing slash")
  bad += path_expect(path_dir("/a/b") == "/a", "dir absolute")
  bad += path_expect(path_dir("/") == "/", "dir root only")
  bad += path_expect(path_dir("") == "", "dir empty")
  bad += path_expect(path_base("a/b") == "b", "base plain")
  bad += path_expect(path_base("a/b/") == "", "base trailing slash")
  bad += path_expect(path_base("/a") == "a", "base absolute")
  bad += path_expect(path_base("a") == "a", "base no slash")
  bad += path_expect(path_base("") == "", "base empty")
  bad += path_expect(path_ext("a.txt") == ".txt", "ext simple")
  bad += path_expect(path_ext("a") == "", "ext missing")
  bad += path_expect(path_ext("a.tar.gz") == ".gz", "ext double")
  bad += path_expect(path_ext(".bashrc") == "", "ext dotfile")
  bad += path_expect(path_ext("a.") == ".", "ext trailing dot")
  bad += path_expect(path_ext("dir.x/f") == "", "ext in dir only")
  bad += path_expect(path_ext("a/b/c.brat") == ".brat", "ext nested")
  bad += path_expect(path_norm("a/./b") == "a/b", "norm dot")
  bad += path_expect(path_norm("a//b") == "a/b", "norm double slash")
  bad += path_expect(path_norm("a/b/../c") == "a/c", "norm dotdot")
  bad += path_expect(path_norm("a/b/..") == "a", "norm dotdot last")
  bad += path_expect(path_norm("./a") == "a", "norm leading dot")
  bad += path_expect(path_norm("a/../..") == "..", "norm above root")
  bad += path_expect(path_norm("a/../../b") == "../b", "norm above root deep")
  bad += path_expect(path_norm("") == ".", "norm empty")
  bad += path_expect(path_norm(".") == ".", "norm dot only")
  bad += path_expect(path_norm("/") == "/", "norm root")
  bad += path_expect(path_norm("/..") == "/", "norm root dotdot")
  bad += path_expect(path_norm("/a/b/../c") == "/a/c", "norm absolute dotdot")
  bad += path_expect(path_norm("/a//b/./c") == "/a/b/c", "norm absolute mixed")
  if bad > 0 {
    print("path {bad} FAIL")
    return 1
  }
  print("path ok")
  return 0
}
