fn is_digit(ch: str) -> bool {
  return ch >= "0" && ch <= "9"
}
fn is_alpha(ch: str) -> bool {
  return (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}
fn is_alnum(ch: str) -> bool {
  return is_alpha(ch) || is_digit(ch)
}
fn is_kw(w: str) -> bool {
  return w in ["let", "mut", "fn", "if", "else", "while", "return", "true", "false", "or", "try", "catch", "spawn", "match", "for", "in", "import", "defer", "move", "break", "continue", "impl", "self", "trait", "enum", "const", "pub"]
}
fn lex(src: str) -> i64 {
  let mut i: i64 = 0
  while i < len(src) {
    let ch = src[i]
    if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
      i += 1
    } else {
      if ch == "/" && i + 1 < len(src) && src[i + 1] == "/" {
        while i < len(src) && src[i] != "\n" {
          i += 1
        }
      } else {
        if ch == "\"" {
          let mut j = i + 1
          while j < len(src) && src[j] != "\"" {
            if src[j] == "\\" {
              j += 1
            }
            j += 1
          }
          print("STR:" + s_slice(src, i, j + 1))
          i = j + 1
        } else {
          if is_digit(ch) {
            let mut j = i
            let mut seen_dot = false
            while j < len(src) && (is_digit(src[j]) || (src[j] == "." && !seen_dot && is_digit(src[j + 1]))) {
              if src[j] == "." {
                seen_dot = true
              }
              j += 1
            }
            if j < len(src) && (src[j] == "e" || src[j] == "E") {
              let mut k = j + 1
              if k < len(src) && (src[k] == "+" || src[k] == "-") {
                k += 1
              }
              if k < len(src) && is_digit(src[k]) {
                while k < len(src) && is_digit(src[k]) {
                  k += 1
                }
                j = k
              }
            }
            print("NUM:" + s_slice(src, i, j))
            i = j
          } else {
            if is_alpha(ch) {
              let mut j = i
              while j < len(src) && is_alnum(src[j]) {
                j += 1
              }
              let w = s_slice(src, i, j)
              if is_kw(w) {
                print("KW:" + w)
              } else {
                print("ID:" + w)
              }
              i = j
            } else {
              let two = s_slice(src, i, i + 2)
              if two in ["..", "=>", "->", "==", "!=", "<=", ">=", "&&", "||", "+=", "-=", "*=", "/=", "%="] {
                print("OP:" + two)
                i += 2
              } else {
                if ch == "." {
                  print("DOT:.")
                } else {
                  print("OP:" + ch)
                }
                i += 1
              }
            }
          }
        }
      }
    }
  }
  print("EOF")
  return 0
}
fn s_slice(s: str, a: i64, b: i64) -> str {
  let mut out = ""
  let mut k = a
  while k < b && k < len(s) {
    out += s[k]
    k += 1
  }
  return out
}
fn main() -> i64 {
  let a = args()
  if len(a) == 0 {
    print("usage: bratc file.brat")
    return 0
  }
  let src = read_file(a[0])?
  return lex(src)
}
