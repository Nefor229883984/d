fn heavy(n: i64) -> i64 {
  let mut t = 0
  for i in 0..n {
    t = t + i
  }
  return t
}
let mut results = {"a": 0, "b": 0, "c": 0}
spawn {
  results["a"] = heavy(100)
}
spawn {
  results["b"] = heavy(200)
}
spawn {
  results["c"] = heavy(300)
}
join_all()
assert(results["a"] == 4950)
assert(results["b"] == 19900)
assert(results["c"] == 44850)
let mut seq = [0]
for i in 1..4 {
  spawn {
    seq.push(i)
  }
}
join_all()
let mut total = 0
for x in seq {
  total = total + x
}
assert(total == 6)
print("spawn ok")
