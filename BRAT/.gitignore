# BRAT — игнорируемое
#
# Правило простое: в репозитории лежит только исходник языка.
# Всё, что можно воспроизвести, генерируется.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Нативный бэкенд: эмитится и собирается, в репозитории лежать не должен ---
*.c
!lang/engine/**/*.h
*.o
*.obj
*.exe
*.so
*.dylib
*.dll
*.a
*.lib
zig-out/
zig-cache/
.zig-cache/

# --- Артефакты прогонов ---
*.log
*.jsonl
*.trace
/tmp/
/out/
/build/

# --- Сертификаты и секреты (НИКОГДА в репозитории) ---
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
.env
.env.*
!.env.example
secrets/
certs/
!docs/**/*.example.pem

# --- Кэши инструментов ---
zig-cache/
__pycache__/
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Мусор от вин-путей (тесты раньше писали сюда) ---
# экранированы: двоеточие и обратные слэши в имени каталога
C\:*/
*C\:*

# --- Архивы и редакторы ---
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.swp