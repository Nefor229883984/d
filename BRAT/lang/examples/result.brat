import lib
fn main() -> i64 {
  let good = safe_div(10, 2)?
  print(good)
  let bad = safe_div(1, 0)
  if is_err(bad) {
    log.warn("caught div by zero")
  }
  let fallback = pick_first([]) or 99
  print(fallback)
  let zero = 0 or 5
  print(zero)
  let maybe = pick_first([7, 8])
  print(unwrap(maybe))
  let empty = pick_first([])
  print(is_none(empty))
  return 0
}
