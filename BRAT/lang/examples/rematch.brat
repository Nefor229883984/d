assert(re_match("hello", "ell"))
assert(re_match("hello", "^hello$"))
assert(!re_match("hello", "^ello$"))
assert(re_match("aaa", "a*$"))
assert(re_match("aXb", "a.b"))
assert(re_match("123abc", "^\d+"))
assert(re_match("123abc", "[a-z]+$"))
assert(!re_match("123", "[a-z]+$"))
assert(re_match("color", "colou?r"))
assert(re_match("colour", "colou?r"))
assert(re_match("abc", "a.c"))
assert(!re_match("abc", "a.*z"))
assert(re_match("abbbz", "ab+z"))
assert(re_match("x123y", "\d+"))
assert(re_match("  pad", "\s+pad$"))
print("re ok")
