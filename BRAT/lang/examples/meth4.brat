let v = [1, 2, 3]
let mut c = v.copy()
c.push(4)
assert(len(v) == 3)
assert(len(c) == 4)
let m = {"a": 1}
let mut mc = m.copy()
mc["b"] = 2
assert(!m.has("b"))
assert(mc.has("b"))
assert("ab".copy() == "ab")
assert("abc".chars() == ["a", "b", "c"])
assert(len("".chars()) == 0)
let pf = "2.5".parse_float()
assert(unwrap(pf) == 2.5)
assert(is_err("xx".parse_float()))
let z = [1, 2, 3].zip(["a", "b"])
assert(z[0][0] == 1)
assert(z[0][1] == "a")
assert(len(z) == 2)
let ch = [1, 2, 3, 4, 5].chunks(2)
assert(ch[0] == [1, 2])
assert(ch[1] == [3, 4])
assert(ch[2] == [5])
assert(len([1, 2, 3].chunks(1)) == 3)
print("meth4 ok")
