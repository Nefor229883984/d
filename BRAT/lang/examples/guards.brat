enum Res {
  Ok(v),
  Err(e)
}
fn classify(r) -> i64 {
  match r {
    Ok(v) if v > 100 => {
      return 3
    },
    Ok(v) if v > 10 => {
      return 2
    },
    Ok(v) => {
      return 1
    },
    Err(e) => {
      return -1
    }
  }
  return 0
}
assert(classify(Ok(200)) == 3)
assert(classify(Ok(50)) == 2)
assert(classify(Ok(5)) == 1)
assert(classify(Err("x")) == -1)
let mut n = 0
match 7 {
  x if x > 100 => {
    n = 99
  },
  _ => {
    n = 1
  }
}
assert(n == 1)
print("guards ok")
